# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# KouroB node internals
.kourob/keys/
.kourob/cache/
.kourob/gen/
*.key
*.pem

# Data: bronze and weights are DVC-tracked, not git-tracked
data/bronze/**
!data/bronze/.gitkeep
tiers/t1/weights/
*.onnx
*.safetensors

# Beads keeps a local SQLite cache; the JSONL is the git-tracked source of truth
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Scratch nodes created by running the CLI in the repo root
/demo/
/tmp-node*/
