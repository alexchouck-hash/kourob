{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trooth.io/schema/scorecard/v0.1.json",
  "title": "TroothScorecard",
  "description": "Standard six-dimension scorecard with mechanical metrics and optional anchored accuracy.",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source_name",
    "method_version",
    "generated_at",
    "scoring_window",
    "dimensions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "method_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scoring_window": {
      "type": "object",
      "required": ["start", "end", "snapshot_count"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "snapshot_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": [
        "freshness_lag",
        "revision_behavior",
        "correction_latency",
        "completeness_by_segment",
        "schema_stability",
        "internal_consistency"
      ],
      "properties": {
        "freshness_lag": {
          "type": "object",
          "required": ["p50_seconds", "p95_seconds", "sample_count"],
          "properties": {
            "p50_seconds": { "type": "number", "minimum": 0 },
            "p95_seconds": { "type": "number", "minimum": 0 },
            "sample_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "revision_behavior": {
          "type": "object",
          "required": ["revision_rate_pct", "revised_records_count", "total_records_count"],
          "properties": {
            "revision_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "revised_records_count": { "type": "integer", "minimum": 0 },
            "total_records_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "correction_latency": {
          "type": "object",
          "required": ["p50_seconds", "p95_seconds", "events_evaluated"],
          "properties": {
            "p50_seconds": { "type": ["number", "null"], "minimum": 0 },
            "p95_seconds": { "type": ["number", "null"], "minimum": 0 },
            "events_evaluated": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "completeness_by_segment": {
          "type": "object",
          "required": ["overall_pct", "segments"],
          "properties": {
            "overall_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "segments": {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "additionalProperties": false
        },
        "schema_stability": {
          "type": "object",
          "required": ["stable_snapshots_pct", "schema_changes_count"],
          "properties": {
            "stable_snapshots_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "schema_changes_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "internal_consistency": {
          "type": "object",
          "required": ["consistent_snapshots_pct", "contradictions_count"],
          "properties": {
            "consistent_snapshots_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "contradictions_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "accuracy": {
      "type": "object",
      "description": "Accuracy metric. Invalid unless anchor is present naming the authoritative reference.",
      "required": ["anchor", "metric", "score"],
      "properties": {
        "anchor": {
          "type": "string",
          "minLength": 3,
          "description": "Authoritative settlement reference or ground-truth anchor."
        },
        "metric": {
          "type": "string",
          "description": "Evaluation metric name (e.g. MAE, RMSE, exact_match_pct)."
        },
        "score": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
